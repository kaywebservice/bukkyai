# ── bukkyai environment (optional) ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is never committed.

# Firebase Web config — the web API key is public by design (safe to expose).
# For guest auth (email/password, Google popup, anonymous).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Creem — NO publishable key exists (unlike Stripe). API keys are secret/server-side.
# Recommended: use hosted checkout links (paste a checkout URL in Settings).
# Optional: if you run your own serverless checkout function that holds the secret key,
# put its URL here so the site can POST the cart to it.
VITE_CHECKOUT_ENDPOINT=

# Default payment/checkout link used by the site's cart when no per-project link is set.
VITE_DEFAULT_PAYMENT_LINK=

# Publish & share (Pro). Point at your deployed server/worker.js. Leave empty to disable.
VITE_PUBLISH_ENDPOINT=
# License value shared with the worker (server secret PRO_LICENSE_KEY). Leave empty to skip.
VITE_PRO_LICENSE_KEY=
